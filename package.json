{
  "name": "sarandi-newsroom-dashboard",
  "version": "1.0.7",
  "description": "Dashboard desktop para a equipe de jornalismo da RÃ¡dio Sarandi",
  "main": "./out/main/index.js",
  "author": "RÃ¡dio Sarandi",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.radiosarandi.newsroom-dashboard",
    "productName": "Sarandi Newsroom Dashboard",
    "publish": {
      "provider": "github",
      "owner": "lnpti",
      "repo": "sarandi-newsroom-dashboard"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}
